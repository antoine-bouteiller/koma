test "the app opens on the Library tab"
  expect state nav.tab == "library"
  expect text "title-library" == "Library"

test "each tab opens its own screen"
  tap "tab-updates"
  expect state nav.tab == "updates"
  expect text "title-updates" == "Updates"
  tap "tab-history"
  expect state nav.tab == "history"
  expect text "title-history" == "History"
  tap "tab-discover"
  expect state nav.tab == "discover"
  expect text "title-discover" == "Discover"
  tap "tab-library"
  expect state nav.tab == "library"

test "the web host shows no update banner"
  expect tree has "tabs"
  expect tree missing "update-banner"

test "an empty tab says what will show up there"
  expect tree has "empty-library"
  tap "tab-discover"
  expect tree has "empty-discover"
