// Koma: the view. app.ts answers what it asks for.
shape Status
  message: string

shape Delivery
  staged: bool

routes nav
  home "/"

component Koma
  resource status = status() as shape Status
  resource delivery = exactDelivery() as shape Delivery
  action update
    deliveryActivate()
  view
    main testId="root" navigationKey=`${top(nav).id}` width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationScroll="content" position="absolute" inset=0 display="flex" flex-direction="column"
          header display="flex" align-items="center"
            text "Koma" role="heading" aria-level=1 flex=1
          scroll id="content" flex=1 min-height=0 padding=16
            if delivery.staged
              row testId="update-banner" gap=8 align-items="center" margin-bottom=16
                text "An update is ready." flex=1
                button press=update buttonStyle="filled" testId="update-now"
                  text "Update"
            text status.message testId="status"
