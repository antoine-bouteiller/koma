{
  projectRootFile = "flake.nix";

  programs = {
    alejandra.enable = true;
    deadnix.enable = true;
    statix.enable = true;
    oxfmt.enable = true;
    ktfmt.enable = true;
  };

  settings.formatter.ktfmt.options = ["--kotlinlang-style"];

  settings.global.excludes = [
    "CLAUDE.md"
    # Generated by `gradle wrapper`.
    "gradlew"
    "gradlew.bat"
    "gradle/wrapper/**"
    # Hand-wrapped prose; oxfmt would pad every table.
    "*.md"
    # Copied from Mihon and keiyoushi, kept as upstream wrote them.
    "app/src/main/kotlin/eu/kanade/tachiyomi/**"
    "app/src/main/kotlin/keiyoushi/**"
  ];
}
