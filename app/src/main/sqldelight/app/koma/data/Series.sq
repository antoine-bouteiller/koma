-- Public series data, kept across sign-outs. An empty title marks an id MangaBaka no longer answers.
CREATE TABLE IF NOT EXISTS series (id INTEGER PRIMARY KEY, title TEXT NOT NULL, cover TEXT NOT NULL, type TEXT NOT NULL);

ids:
SELECT id FROM series;

upsert:
INSERT OR REPLACE INTO series (id, title, cover, type) VALUES (?, ?, ?, ?);

-- The series' stored title and cover, and its library state: null when it is not in the library.
withEntry:
SELECT s.title, s.cover, e.state FROM series s LEFT JOIN library_entry e ON e.series_id = s.id WHERE s.id = ?;
