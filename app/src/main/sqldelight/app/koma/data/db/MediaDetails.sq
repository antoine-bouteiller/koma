-- Public data, kept across sign-outs: the backend's details of a media, as JSON.
CREATE TABLE IF NOT EXISTS media_details (backend TEXT NOT NULL, id TEXT NOT NULL, details TEXT NOT NULL, color_cover TEXT, color_seed INTEGER, PRIMARY KEY (backend, id));

one:
SELECT details FROM media_details WHERE backend = ? AND id = ?;

upsert:
INSERT OR REPLACE INTO media_details (backend, id, details) VALUES (?, ?, ?);

colors:
SELECT color_cover, color_seed FROM media_details WHERE backend = ? AND id = ?;

cacheColors:
UPDATE media_details SET color_cover = ?, color_seed = ? WHERE backend = ? AND id = ?;
