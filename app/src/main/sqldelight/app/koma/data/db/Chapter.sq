-- Public data, kept across sign-outs: the chapters a source last listed for a manga, in its order. `source` is Mihon's Source.id.
CREATE TABLE IF NOT EXISTS chapter (source INTEGER NOT NULL, manga_url TEXT NOT NULL, position INTEGER NOT NULL, url TEXT NOT NULL, name TEXT NOT NULL, scanlator TEXT, number REAL NOT NULL, uploaded INTEGER NOT NULL, PRIMARY KEY (source, manga_url, position));

-- The source manga whose chapters are stored, so a manga without chapters is told from one never listed.
CREATE TABLE IF NOT EXISTS chapter_list (source INTEGER NOT NULL, manga_url TEXT NOT NULL, PRIMARY KEY (source, manga_url));

-- The signed-in person's data, cleared at sign-out: the chapters a refetch found missing from the stored list, at `found_at` (epoch ms).
CREATE TABLE IF NOT EXISTS chapter_update (source INTEGER NOT NULL, manga_url TEXT NOT NULL, url TEXT NOT NULL, found_at INTEGER NOT NULL, PRIMARY KEY (source, manga_url, url));

listed:
SELECT count(*) FROM chapter_list WHERE source = ? AND manga_url = ?;

stored:
SELECT url, name, scanlator, number, uploaded FROM chapter WHERE source = ? AND manga_url = ? ORDER BY position;

clear:
DELETE FROM chapter WHERE source = ? AND manga_url = ?;

put:
INSERT INTO chapter (source, manga_url, position, url, name, scanlator, number, uploaded) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

list:
INSERT OR REPLACE INTO chapter_list (source, manga_url) VALUES (?, ?);

found:
INSERT OR IGNORE INTO chapter_update (source, manga_url, url, found_at) VALUES (?, ?, ?, ?);

-- The found chapters each library title's screen shows, newest found first, each title's in its source's order.
-- Its last condition, like shownInLibrary's, is withoutOutdatedParts in LibraryRepository.kt.
updates:
SELECT u.found_at, c.url, c.name, m.* FROM chapter_update u
JOIN chapter c ON c.source = u.source AND c.manga_url = u.manga_url AND c.url = u.url
JOIN binding b ON b.source = u.source AND b.manga_url = u.manga_url
JOIN library_entry e ON e.backend = b.backend AND e.media_id = b.media_id
JOIN media m ON m.backend = b.backend AND m.id = b.media_id
WHERE b.backend = ? AND m.title != '' AND NOT EXISTS (
  SELECT 1 FROM excluded_scanlator x WHERE x.backend = b.backend AND x.media_id = b.media_id AND x.scanlator = c.scanlator
)
AND (c.number = CAST(c.number AS INTEGER) OR CAST(c.number AS INTEGER) >= (
  SELECT MAX(CAST(l.number AS INTEGER)) FROM chapter l WHERE l.source = c.source AND l.manga_url = c.manga_url
))
ORDER BY u.found_at DESC, m.id, c.position;

clearUpdates:
DELETE FROM chapter_update;

-- The chapters each library title's screen shows: its bound source manga's, without hidden scanlators' nor outdated part chapters.
shownInLibrary:
SELECT e.media_id, e.progress, c.number FROM library_entry e
JOIN binding b ON b.backend = e.backend AND b.media_id = e.media_id
JOIN chapter c ON c.source = b.source AND c.manga_url = b.manga_url
WHERE e.backend = ? AND NOT EXISTS (
  SELECT 1 FROM excluded_scanlator x WHERE x.backend = e.backend AND x.media_id = e.media_id AND x.scanlator = c.scanlator
)
AND (c.number = CAST(c.number AS INTEGER) OR CAST(c.number AS INTEGER) >= (
  SELECT MAX(CAST(l.number AS INTEGER)) FROM chapter l WHERE l.source = c.source AND l.manga_url = c.manga_url
));
