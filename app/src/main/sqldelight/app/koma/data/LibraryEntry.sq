CREATE TABLE IF NOT EXISTS library_entry (series_id INTEGER PRIMARY KEY, state TEXT NOT NULL, updated_at TEXT NOT NULL);

shelved:
SELECT e.state, s.id, s.title, s.cover FROM library_entry e JOIN series s ON s.id = e.series_id
WHERE s.title != '' AND s.type != 'novel' ORDER BY e.updated_at DESC, s.id;

upsert:
INSERT OR REPLACE INTO library_entry (series_id, state, updated_at) VALUES (?, ?, ?);

remove:
DELETE FROM library_entry WHERE series_id = ?;

clear:
DELETE FROM library_entry;
